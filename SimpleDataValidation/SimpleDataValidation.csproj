<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.4.0</Version>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>SimpleDataValidation is an open-source .NET library for validating data in a simple and intuitive way.</Title>
    <Company>Pierlam Project</Company>
    <Description>
		SimpleDataValidation is an open-source .NET library designed to validate data in a simple and intuitive way. It provides more than 30 built-in validation functions to check data types, lengths, formats, and much more. These include NotNull, Length, StartsWith, Email, IBAN, and CreditCardNumber.
	</Description>
    <PackageProjectUrl>https://github.com/Pierlam/SimpleDataValidation</PackageProjectUrl>
    <PackageIcon>logo_V_128_basic.jpg</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Pierlam/SimpleDataValidation</RepositoryUrl>
    <PackageTags>csharp;validation;datavalidation;validator;validate;check;verification;input;email;mail;bank;iban;luhn;mod10;credit;card;creditcard;cardnumber;visa;mastercard;discover;amex;americanexpress;jcb;chinaunionpay;diners;dinersclub;dankort;hiper;hipercard;RuPay</PackageTags>
    <Authors>Pierlam</Authors>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\logo_V_128_basic.jpg">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

	<Target Name="InjectPackageReleaseNotesFromFile" BeforeTargets="GenerateNuspec" Condition="Exists('CHANGELOG.md')">
		<PropertyGroup>
			<PackageReleaseNotes>$([System.IO.File]::ReadAllText("$(MSBuildProjectDirectory)/CHANGELOG.md"))</PackageReleaseNotes>
		</PropertyGroup>
	</Target>
</Project>
