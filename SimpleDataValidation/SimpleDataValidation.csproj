<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.4.0</Version>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>SimpleDataValidation is an open-source .NET library for validating data in a simple and intuitive way.</Title>
    <Company>Pierlam Project</Company>
    <Description>
		An open-source .NET library for validating data in a simple and intuitive way. There are many available functions, more than 30, to validate data, by type, by length, by format and more like: NotNull, Length, StartsWith, Email, Iban, Card Number,...</Description>
    <PackageProjectUrl>https://github.com/Pierlam/SimpleDataValidation</PackageProjectUrl>
    <PackageIcon>logo_V_128_basic.jpg</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Pierlam/SimpleDataValidation</RepositoryUrl>
    <PackageTags>csharp;validation;datavalidation;validator;validate;check;verification;email;mail;bank;iban;luhn;credit;card;creditcard;cardnumber;visa;mastercard;discover;amex;americanexpress;jcb;chinaunionpay;diners;dinersclub</PackageTags>
    <Authors>Pierlam</Authors>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\logo_V_128_basic.jpg">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

	<Target Name="InjectPackageReleaseNotesFromFile" BeforeTargets="GenerateNuspec" Condition="Exists('CHANGELOG.md')">
		<PropertyGroup>
			<PackageReleaseNotes>$([System.IO.File]::ReadAllText("$(MSBuildProjectDirectory)/CHANGELOG.md"))</PackageReleaseNotes>
		</PropertyGroup>
	</Target>
</Project>
